# Materialized pixi environments (provisioned by scripts/ensure-env.sh from the
# committed pixi.toml / pixi.lock). Never committed — regenerated per machine.
.pixi/
**/.pixi/
__pycache__/

# Python test caches. pytest writes a `.gitignore` containing `*` inside its
# own cache directory, so git reports a clean tree while the directory sits
# there — and sync-mirrors.sh copies it into the generated surfaces and then
# reports drift against the committed ones. The consistency check fails and
# nothing in `git status` points at why.
.pytest_cache/
**/.pytest_cache/

# Local credentials, symlinked in per-machine. Never committed — this repo is public.
.secrets
.secrets/

# Vendored npm dependencies — reconstructible from the committed package.json
# and package-lock.json (npm ci). 3,443 files / 52 MB were tracked here for a
# month before anyone noticed (GH-183); opencode behaves identically with the
# directory absent, and provisions its own deps when it wants them.
node_modules/
